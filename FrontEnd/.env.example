# Copy this file to .env.local and fill in your own values. .env.local is git-ignored.
# Restart `npm run dev` after editing: Next.js reads these at startup.

# Address search at checkout (DeliveryAddressPicker). Free key: https://myprojects.geoapify.com
# Create a project, copy its API key. Shown in the browser, so restrict it to your domains in Geoapify.
NEXT_PUBLIC_GEOAPIFY_API_KEY=

# Optional (defaults shown)
# NEXT_PUBLIC_API_URL=http://localhost:8080
# NEXT_PUBLIC_USE_MOCKS=false
# NEXT_PUBLIC_ENABLE_PAYMENTS=false
