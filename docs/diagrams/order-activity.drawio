<mxCell id="login" value="Log in&lt;br&gt;(authenticated session, R-REG-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_cust"><mxGeometry x="50" y="110" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="choose" value="Choose items from one restaurant,&lt;br&gt;delivery address (address search)&lt;br&gt;and card details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_cust"><mxGeometry x="40" y="205" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="submit" value="Submit order lines&lt;br&gt;+ delivery address + card" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_cust"><mxGeometry x="50" y="320" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="d_avail" value="Restaurant open and&lt;br&gt;all items available?&lt;br&gt;[R-ORD-02]" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="L_ord"><mxGeometry x="50" y="300" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="refuse" value="Refuse with clear message&lt;br&gt;(no order created,&lt;br&gt;nothing charged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=12;" vertex="1" parent="L_ord"><mxGeometry x="270" y="320" width="180" height="60" as="geometry"/></mxCell>
