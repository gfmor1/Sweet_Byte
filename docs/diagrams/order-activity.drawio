<mxCell id="note_events" value="Every transition is recorded as a DomainEvent with an event id (R-ORD-05). No transition may skip a state (R-ORD-04)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFFCC;strokeColor=#B3B300;align=left;spacingLeft=6;fontSize=10;" vertex="1" parent="L_rest"><mxGeometry x="15" y="85" width="210" height="90" as="geometry"/></mxCell>
