<mxCell id="fare" value="Compute fare (R-PRC-01)&lt;br&gt;= sum of order lines&lt;br&gt;+ delivery fee + service fee&lt;br&gt;+ small-order surcharge&lt;br&gt;if subtotal &amp;lt; threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_prc"><mxGeometry x="40" y="425" width="220" height="90" as="geometry"/></mxCell>
