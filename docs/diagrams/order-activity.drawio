<mxCell id="placed" value="Order --&amp;gt; &lt;b&gt;placed&lt;/b&gt;&lt;br&gt;(paid, delivery address&lt;br&gt;stored on the order)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=12;" vertex="1" parent="L_ord"><mxGeometry x="30" y="555" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="d_next" value="Next command on&lt;br&gt;the placed order?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="L_ord"><mxGeometry x="50" y="660" width="180" height="100" as="geometry"/></mxCell>
<mxCell id="rejected" value="Order --&amp;gt; &lt;b&gt;rejected&lt;/b&gt;&lt;br&gt;(reason stored)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=12;" vertex="1" parent="L_ord"><mxGeometry x="270" y="680" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="cancelled1" value="Order --&amp;gt; &lt;b&gt;cancelled&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=12;" vertex="1" parent="L_ord"><mxGeometry x="270" y="835" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="accept" value="Accept order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_rest"><mxGeometry x="20" y="800" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="accepted" value="Order --&amp;gt; &lt;b&gt;accepted&lt;/b&gt;&lt;br&gt;appended to preparation queue&lt;br&gt;(arrival order, never refused - R-ORD-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=12;" vertex="1" parent="L_ord"><mxGeometry x="30" y="905" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="d_op1" value="Operator cancels?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="L_ord"><mxGeometry x="60" y="1020" width="160" height="80" as="geometry"/></mxCell>
<mxCell id="cancelled2" value="Order --&amp;gt; &lt;b&gt;cancelled&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=12;" vertex="1" parent="L_ord"><mxGeometry x="270" y="1035" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="start_prep" value="Start preparing&lt;br&gt;[at front of queue - R-ORD-03]&lt;br&gt;[status = accepted - R-ORD-04]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_rest"><mxGeometry x="15" y="1135" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="preparing" value="Order --&amp;gt; &lt;b&gt;preparing&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=12;" vertex="1" parent="L_ord"><mxGeometry x="40" y="1140" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="d_op2" value="Operator cancels?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="L_ord"><mxGeometry x="60" y="1250" width="160" height="80" as="geometry"/></mxCell>
<mxCell id="cancelled3" value="Order --&amp;gt; &lt;b&gt;cancelled&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=12;" vertex="1" parent="L_ord"><mxGeometry x="270" y="1265" width="180" height="50" as="geometry"/></mxCell>
<mxCell id="mark_ready" value="Mark order ready&lt;br&gt;[status = preparing - R-ORD-04]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_rest"><mxGeometry x="15" y="1370" width="210" height="60" as="geometry"/></mxCell>
<mxCell id="ready" value="Order --&amp;gt; &lt;b&gt;ready&lt;/b&gt;&lt;br&gt;(now visible to DLV)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=12;" vertex="1" parent="L_ord"><mxGeometry x="40" y="1370" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="credit_refund" value="Automatic credit refund:&lt;br&gt;REFUND billing record (-fare)&lt;br&gt;+ final-state ledger CHARGE of 0&lt;br&gt;(R-PRC-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_prc"><mxGeometry x="40" y="955" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="end_credit" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="L_prc"><mxGeometry x="135" y="1075" width="30" height="30" as="geometry"/></mxCell>
<mxCell id="dispatch" value="Dispatch the order&lt;br&gt;[status = ready, no courier - R-DLV-01]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_dlv"><mxGeometry x="30" y="1610" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="d_courier" value="Eligible idle on-duty&lt;br&gt;courier exists?&lt;br&gt;(not one who declined this&lt;br&gt;order or holds a pending offer)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="L_dlv"><mxGeometry x="25" y="1710" width="230" height="130" as="geometry"/></mxCell>
<mxCell id="hold" value="Hold order in dispatch queue&lt;br&gt;FIFO by ready time&lt;br&gt;(visible to operator - R-DLV-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_dlv"><mxGeometry x="275" y="1740" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="d_op3" value="Operator cancels?&lt;br&gt;[no courier assigned]" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="L_dlv"><mxGeometry x="280" y="1865" width="180" height="90" as="geometry"/></mxCell>
<mxCell id="cancelled4" value="Order --&amp;gt; &lt;b&gt;cancelled&lt;/b&gt;&lt;br&gt;(operator command)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=12;" vertex="1" parent="L_ord"><mxGeometry x="270" y="1880" width="180" height="60" as="geometry"/></mxCell>
<mxCell id="wait" value="Wait until a courier becomes idle&lt;br&gt;(goes on duty, delivers, declines&lt;br&gt;or is released), then retry&lt;br&gt;(R-DLV-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_dlv"><mxGeometry x="270" y="2005" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="offer" value="Create PENDING delivery offer&lt;br&gt;to the nearest idle courier&lt;br&gt;(straight-line distance,&lt;br&gt;tie --&amp;gt; lowest courier id) [R-DLV-02]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_dlv"><mxGeometry x="30" y="2150" width="220" height="80" as="geometry"/></mxCell>
<mxCell id="d_resp" value="Courier responds&lt;br&gt;to the offer?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="L_cour"><mxGeometry x="40" y="2140" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="assigned" value="Offer ACCEPTED&lt;br&gt;Courier --&amp;gt; assigned&lt;br&gt;(holds at most one order - R-DLV-03)&lt;br&gt;Order stays ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_cour"><mxGeometry x="20" y="2290" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="d_offline" value="Courier goes offline&lt;br&gt;before pickup?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=10;" vertex="1" parent="L_cour"><mxGeometry x="40" y="2420" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="reassign" value="Reassign stalled order&lt;br&gt;(operator command only,&lt;br&gt;courier released - R-DLV-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_op"><mxGeometry x="25" y="2435" width="210" height="70" as="geometry"/></mxCell>
<mxCell id="pickup" value="Confirm pickup at restaurant&lt;br&gt;[status = ready AND assigned&lt;br&gt;to this courier]&lt;br&gt;[R-ORD-04, R-DLV-01]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_cour"><mxGeometry x="20" y="2570" width="240" height="80" as="geometry"/></mxCell>
<mxCell id="picked" value="Order --&amp;gt; &lt;b&gt;picked_up&lt;/b&gt;&lt;br&gt;Courier --&amp;gt; carrying&lt;br&gt;(cannot go offline - R-DLV-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=12;" vertex="1" parent="L_ord"><mxGeometry x="30" y="2675" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="deliver_c" value="Confirm delivery to customer&lt;br&gt;[status = picked_up - R-ORD-04]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_cour"><mxGeometry x="20" y="2780" width="240" height="60" as="geometry"/></mxCell>
<mxCell id="delivered" value="Order --&amp;gt; &lt;b&gt;delivered&lt;/b&gt;&lt;br&gt;Courier --&amp;gt; idle&lt;br&gt;(triggers dispatch retry - R-DLV-04)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=11;arcSize=12;" vertex="1" parent="L_ord"><mxGeometry x="30" y="2875" width="220" height="70" as="geometry"/></mxCell>
<mxCell id="charge" value="Record final-state ledger CHARGE&lt;br&gt;(amount = fare total,&lt;br&gt;final state, all timestamps&lt;br&gt;- R-PRC-03)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_prc"><mxGeometry x="40" y="2965" width="220" height="90" as="geometry"/></mxCell>
<mxCell id="summary_p" value="Provide order summary&lt;br&gt;(fare breakdown + ledger, R-PRC-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_prc"><mxGeometry x="40" y="3110" width="220" height="60" as="geometry"/></mxCell>
<mxCell id="view" value="View order summary" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EE;strokeColor=#B46504;fontSize=11;arcSize=12;" vertex="1" parent="L_cust"><mxGeometry x="50" y="3110" width="200" height="60" as="geometry"/></mxCell>
